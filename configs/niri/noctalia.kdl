// Disabled: this duplicated the "layout" node already defined in config.kdl,
// and since this file is included last, it was silently overriding your
// focus-ring/border/shadow colors with noctalia's yellow theme instead.
// Re-enable (remove the "/-") if you want the yellow accent back.
/-layout {

    focus-ring {
        active-color   "#e0e467"
        inactive-color "#22231b"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#e0e467"
        inactive-color "#22231b"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#22231b70"
    }

    tab-indicator {
        active-color   "#e0e467"
        inactive-color "#898d0c"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#e0e46780"
    }
}

recent-windows {
    highlight {
        active-color "#e0e467"
        urgent-color "#fd4663"
    }
}
