#!/bin/bash

set -u

ART="/usr/share/niri-rice/tty/l-ascii.txt"

get_terminal_size() {
    local rows cols
    rows=$(tput lines 2>/dev/null || printf '24')
    cols=$(tput cols 2>/dev/null || printf '80')
    [[ "$rows" =~ ^[0-9]+$ ]] || rows=24
    [[ "$cols" =~ ^[0-9]+$ ]] || cols=80
    printf '%s %s\n' "$rows" "$cols"
}

read -r rows cols < <(get_terminal_size)

art_lines=()
art_width=0
common_indent=

if [[ -r "$ART" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
        art_lines+=("$line")

        [[ -z "$line" ]] && continue

        indent="${line%%[^[:space:]]*}"
        indent_len=${#indent}

        if [[ -z "$common_indent" || "$indent_len" -lt "$common_indent" ]]; then
            common_indent=$indent_len
        fi
    done < "$ART"
fi

common_indent=${common_indent:-0}

trimmed_lines=()
for line in "${art_lines[@]}"; do
    if (( common_indent > 0 )); then
        line="${line:$common_indent}"
    fi

    trimmed_lines+=("$line")
    (( ${#line} > art_width )) && art_width=${#line}
done

art_lines=("${trimmed_lines[@]}")

read -r rows cols < <(get_terminal_size)
content_lines=$(( ${#art_lines[@]} + 3 ))
top_padding=$(( (rows - content_lines) / 2 ))
(( top_padding < 0 )) && top_padding=0

clear
printf '\n%.0s' $(seq 1 "$top_padding")

for line in "${art_lines[@]}"; do
    padding=0
    (( cols > art_width )) && padding=$(( (cols - art_width) / 2 ))
    printf '%*s%s\n' "$padding" '' "$line"
done

printf '\n'

# Keep util-linux login/PAM authentication, but proxy its prompt output through
# a PTY so both login: and Password: are positioned in the terminal center.
# The actual credentials and authentication remain handled by /usr/bin/login.
if command -v python3 >/dev/null 2>&1; then
    TTY_COLS="$cols" TTY_ROWS="$rows" python3 - <<'PY'
import errno
import fcntl
import os
import pty
import signal
import struct
import sys
import termios

cols = int(os.environ.get("TTY_COLS", "80"))
rows = int(os.environ.get("TTY_ROWS", "24"))
PROMPTS = (b"login: ", b"Password: ")
pending = b""


def centered_prompt(prompt: bytes) -> bytes:
    start = max(1, (cols - len(prompt.rstrip()) + 2) // 2)
    return b"\r\x1b[K\x1b[" + str(start).encode() + b"G" + prompt


def set_winsize(fd: int) -> None:
    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))


def read_from_master(fd: int) -> bytes:
    global pending
    try:
        data = os.read(fd, 4096)
    except OSError as exc:
        if exc.errno == errno.EIO:
            return b""
        raise

    if not data:
        return b""

    pending += data
    output = bytearray()

    while pending:
        matches = [(pending.find(prompt), prompt) for prompt in PROMPTS if pending.find(prompt) >= 0]
        if not matches:
            keep = max(len(prompt) for prompt in PROMPTS) - 1
            if len(pending) > keep:
                output.extend(pending[:-keep])
                pending = pending[-keep:]
            break

        index, prompt = min(matches, key=lambda item: item[0])
        output.extend(pending[:index])
        output.extend(centered_prompt(prompt))
        pending = pending[index + len(prompt):]

    return bytes(output)


pid, master = pty.fork()

if pid == 0:
    os.execv("/usr/bin/login", ["/usr/bin/login"])

set_winsize(master)

try:
    while True:
        data = read_from_master(master)
        if data:
            os.write(sys.stdout.fileno(), data)

        try:
            child_pid, status = os.waitpid(pid, os.WNOHANG)
            if child_pid == pid:
                if pending:
                    os.write(sys.stdout.fileno(), pending)
                break
        except ChildProcessError:
            break

        try:
            input_data = os.read(sys.stdin.fileno(), 4096)
            if input_data:
                os.write(master, input_data)
        except OSError:
            break
except KeyboardInterrupt:
    try:
        os.kill(pid, signal.SIGINT)
    except ProcessLookupError:
        pass
finally:
    try:
        os.close(master)
    except OSError:
        pass
PY
else
    # Safe fallback if Python is unavailable: preserve normal PAM login.
    exec /usr/bin/login
fi
