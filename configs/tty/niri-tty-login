#!/usr/bin/env python3

import os
import re
import select
import shutil
import sys
import termios
import tty

ART = "/usr/share/niri-rice/tty/l-ascii.txt"


def terminal_size():
    size = shutil.get_terminal_size((80, 24))
    return size.lines, size.columns


def load_art():
    try:
        with open(ART, encoding="utf-8") as handle:
            lines = handle.read().splitlines()
    except OSError:
        lines = []

    while lines and not lines[-1]:
        lines.pop()

    # Remove only the common left margin. This keeps the shape of the logo
    # intact while making room for the login prompts beside it.
    nonempty = [line for line in lines if line.strip()]
    if nonempty:
        margin = min(len(line) - len(line.lstrip()) for line in nonempty)
        if margin:
            lines = [line[margin:] if line else line for line in lines]

    return lines


def render_login_screen():
    rows, cols = terminal_size()
    art = load_art()
    art_width = max((len(line) for line in art), default=0)
    art_height = len(art)

    # Keep the logo on the left and the real login prompts on the right.
    # The whole two-column layout is centered as one group.
    gap = 6
    prompt_width = len("Password: ")
    total_width = art_width + gap + prompt_width
    left = max(0, (cols - total_width) // 2)
    art_left = left
    prompt_left = left + art_width + gap

    top = max(0, (rows - art_height) // 2)

    sys.stdout.write("\033[2J\033[H")
    for index, line in enumerate(art):
        sys.stdout.write(f"\033[{top + index + 1};{art_left + 1}H{line}")
    sys.stdout.flush()

    return top + (art_height // 2), prompt_left


def centered_prompt(text, row, column):
    return f"\033[2K\033[{row + 1};{column + 1}H{text}".encode()


login_row, prompt_column = render_login_screen()
password_row = login_row + 1

pid, master_fd = os.forkpty()

if pid == 0:
    os.execv("/usr/bin/login", ["/usr/bin/login"])

old_terminal = termios.tcgetattr(sys.stdin.fileno())
state = "login"
buffer = bytearray()

try:
    tty.setraw(sys.stdin.fileno())

    while True:
        readable, _, _ = select.select([master_fd, sys.stdin], [], [])

        if master_fd in readable:
            try:
                data = os.read(master_fd, 4096)
            except OSError:
                break

            if not data:
                break

            buffer.extend(data)

            if state == "login":
                match = re.search(rb"login:\s*$", buffer)
                if match:
                    before = buffer[:match.start()]
                    if before:
                        os.write(sys.stdout.fileno(), before)
                    os.write(sys.stdout.fileno(), centered_prompt("login: ", login_row, prompt_column))
                    buffer.clear()
                    state = "username"
                    continue

            if state == "username":
                match = re.search(rb"Password:\s*$", buffer)
                if match:
                    before = buffer[:match.start()]
                    if before:
                        os.write(sys.stdout.fileno(), before)
                    os.write(sys.stdout.fileno(), centered_prompt("Password: ", password_row, prompt_column))
                    buffer.clear()
                    state = "password"
                    continue

            if state == "password":
                match = re.search(rb"login:\s*$", buffer)
                if match:
                    before = buffer[:match.start()]
                    if before:
                        os.write(sys.stdout.fileno(), before)
                    os.write(sys.stdout.fileno(), centered_prompt("login: ", login_row, prompt_column))
                    buffer.clear()
                    state = "username"
                    continue

            if len(buffer) > 4096:
                os.write(sys.stdout.fileno(), buffer)
                buffer.clear()

        if sys.stdin in readable:
            data = os.read(sys.stdin.fileno(), 4096)
            if not data:
                break
            os.write(master_fd, data)

finally:
    termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old_terminal)
    if buffer:
        os.write(sys.stdout.fileno(), buffer)

_, status = os.waitpid(pid, 0)
if os.WIFEXITED(status):
    sys.exit(os.WEXITSTATUS(status))
sys.exit(1)
