#!/bin/bash

set -u

ART="/usr/share/niri-rice/tty/l-ascii.txt"
HOSTNAME_DISPLAY="ArchOS-Larptop"

get_terminal_size() {
    local rows cols
    rows=$(tput lines 2>/dev/null || printf '24')
    cols=$(tput cols 2>/dev/null || printf '80')

    [[ "$rows" =~ ^[0-9]+$ ]] || rows=24
    [[ "$cols" =~ ^[0-9]+$ ]] || cols=80

    printf '%s %s\n' "$rows" "$cols"
}

read -r rows cols < <(get_terminal_size)

art_lines=()
art_width=0

if [[ -r "$ART" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
        # Remove only trailing whitespace. Leading whitespace is part of the
        # artwork and must be preserved or the L shape is destroyed.
        line="${line%${line##*[![:space:]]}}"
        art_lines+=("$line")
        (( ${#line} > art_width )) && art_width=${#line}
    done < "$ART"
fi

center_art_line() {
    local line="$1"
    local width="$2"
    local padding=0

    if (( width > art_width )); then
        padding=$(( (width - art_width) / 2 ))
    fi

    printf '%*s%s\n' "$padding" '' "$line"
}

center_text() {
    local text="$1"
    local padding=0

    if (( cols > ${#text} )); then
        padding=$(( (cols - ${#text}) / 2 ))
    fi

    printf '%*s%s' "$padding" '' "$text"
}

# Keep the entire ASCII artwork on one shared canvas. This preserves the
# original shape instead of centering every line independently.
content_lines=$(( ${#art_lines[@]} + 5 ))
top_padding=$(( (rows - content_lines) / 2 ))
(( top_padding < 0 )) && top_padding=0

clear
printf '\n%.0s' $(seq 1 "$top_padding")

for line in "${art_lines[@]}"; do
    center_art_line "$line" "$cols"
done

printf '\n\n'
center_text "${HOSTNAME_DISPLAY} login: "

# Username input begins directly after the centered login label instead of
# being reset to column 1 on the far left.
IFS= read -r username

[[ -n "$username" ]] || exit 1

# Keep the password prompt aligned with the centered login composition.
login_label="${HOSTNAME_DISPLAY} login: "
login_start=$(( (cols - ${#login_label}) / 2 ))
(( login_start < 0 )) && login_start=0
printf '\033[%dG' "$((login_start + 1))"

exec /bin/login "$username"
