#!/bin/bash

set -u

ART="/usr/share/niri-rice/tty/l-ascii.txt"

get_terminal_size() {
    local rows cols
    rows=$(tput lines 2>/dev/null || printf '24')
    cols=$(tput cols 2>/dev/null || printf '80')
    [[ "$rows" =~ ^[0-9]+$ ]] || rows=24
    [[ "$cols" =~ ^[0-9]+$ ]] || cols=80
    printf '%s %s\n' "$rows" "$cols"
}

read -r rows cols < <(get_terminal_size)

art_lines=()
art_width=0

if [[ -r "$ART" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
        art_lines+=("$line")
        (( ${#line} > art_width )) && art_width=${#line}
    done < "$ART"
fi

read -r rows cols < <(get_terminal_size)
content_lines=$(( ${#art_lines[@]} + 3 ))
top_padding=$(( (rows - content_lines) / 2 ))
(( top_padding < 0 )) && top_padding=0

clear
printf '\n%.0s' $(seq 1 "$top_padding")

for line in "${art_lines[@]}"; do
    padding=0
    (( cols > art_width )) && padding=$(( (cols - art_width) / 2 ))
    printf '%*s%s\n' "$padding" '' "$line"
done

printf '\n'

# Let the real system login program handle BOTH username and password.
# The previous custom username + su flow restarted the wrapper after failed
# authentication, which made the username prompt appear again and again.
exec /usr/bin/login
