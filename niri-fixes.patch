+join_sp() {
+    # Joins args with a literal space, regardless of the global IFS setting.
+    local IFS=' '
+    echo "$*"
+}
+
+join_or_none() {
+    if [ "$#" -eq 0 ]; then
+        echo "None"
+    else
+        join_sp "$@"
+    fi
+}
+
